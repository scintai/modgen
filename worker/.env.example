# Copy to `.dev.vars` for `wrangler dev` (`.dev.vars` is gitignored).
# Production: set LITE_URL in wrangler.jsonc vars,
# secrets via `wrangler secret put HF_TOKEN` / `wrangler secret put MIDDLEMAN_KEY`.

# Base URL of deployed lite.py fastapi_app, e.g. https://xxx.modal.run
LITE_URL=https://your-modal-app.modal.run

# Outbound key, sent as X-Api-Key to Modal (== server-side HF_TOKEN). Required.
HF_TOKEN=

# Optional inbound key: if set, reddit-bot must send X-Api-Key == this.
# If empty, the worker accepts unauthenticated enqueue/poll (dev only).
MIDDLEMAN_KEY=
